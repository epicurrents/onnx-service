{
  "name": "@epicurrents/onnx-service",
  "version": "0.1.0",
  "description": "Epicurrents ONNX service",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./workers/*": "./umd/*",
    "./umd/*": "./umd/*"
  },
  "files": [
    "dist/*",
    "umd/*.js",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:workers && npm run build:tsc",
    "build:lib": "vite build",
    "build:tsc": "npm run build:lib && npm run build:types",
    "build:types": "epicurrents-build-types",
    "build:workers": "node scripts/build-workers.mjs",
    "lint": "npm run lint:src",
    "lint:src": "eslint src",
    "prepack": "npm run build",
    "release": "npm publish --access=public",
    "test": "npm run test:unit",
    "test:unit": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epicurrents/onnx-service.git"
  },
  "author": "Sampsa Lohi",
  "license": "Apache-2.0",
  "dependencies": {},
  "devDependencies": {
    "@epicurrents/core": "^1.0.0",
    "@microsoft/tsdoc": "^0.14.1",
    "@typescript-eslint/eslint-plugin": "^6.7.2",
    "@typescript-eslint/parser": "^6.7.2",
    "asymmetric-io-mutex": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.49.0",
    "onnxruntime-web": "^1.14.0",
    "scoped-event-log": "^3.2.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  },
  "peerDependencies": {
    "@epicurrents/core": "^1.0.0",
    "asymmetric-io-mutex": "^1.0.0",
    "onnxruntime-web": "^1.14.0",
    "scoped-event-log": "^3.2.0"
  }
}
